      "voice": "",
      "segments": {
        "en": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(I hope they make more "
              },
              {
                "kind": "FavoriteFood"
              },
              {
                "kind": "Literal",
                "text": "...)"
              }
            ]
