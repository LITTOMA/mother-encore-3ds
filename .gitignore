# Source repository policy. See docs/REPOSITORY_PREPARATION.md.
# Do not remove local files to satisfy these rules; inspect staging before commit.
/build/
/dist/
/upstream/
# The tracked upstream/MOTHER-Encore gitlink and .gitmodules are intentional.
# Ignore rules do not remove tracked submodules; checkout bytes stay in its repo.
/tools/bin/
/toolchain/
/sdk/
/downloads/
/tmp/
/temp/
/HANDOFF_MANIFEST.json

# The optional SDK downloader keeps only its source, template and pinned receipts.
/tools/cloud-sdk/*
!/tools/cloud-sdk/README.md
!/tools/cloud-sdk/env.sh
!/tools/cloud-sdk/fetch-official-sdk.py
!/tools/cloud-sdk/reference/

# Local state, credentials and personal runtime files are never source inputs.
.env
.env.*
!.env.example
!.env.sample
.ssh/
.aws/
.config/
.local/
.cache/
.vscode/
.idea/
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.swp
*.swo
*~
.DS_Store
Thumbs.db
/private/
/secrets/
credentials.json
credentials-*.json
*.credentials.json
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
cookies.txt
cookies.json
*.sav
*.sav.bak
*.sav.tmp
*.state
*.sqlite
*.sqlite3

# Console executables and distributed archives belong in build/dist or Releases.
*.3dsx
*.cia
*.cxi
*.cci
*.elf
*.o
*.a
*.smdh
*.zip
*.7z
*.tar.gz

# Keep the complete checked RomFS baseline: media, receipts and content packs.
# Provenance has cross-pack fingerprints; a clean clone needs the baseline before
# make content regenerates it. Edit recipes/IR only, never generated pack bytes.
/romfs/sandbox.encpak

