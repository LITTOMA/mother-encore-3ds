          "key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_BEDSIDE_DRAWER_0",
          "id": 62,
          "raw": "[@][PartyLead] opened the Bedside drawer.",
          "first_segment": 124,
          "segment_count": 1
        },
        {
          "label": "1",
          "key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_BEDSIDE_DRAWER_1",
          "id": 63,
          "raw": "[@]Inside, there was an Asthma Spray.",
          "first_segment": 125,
          "segment_count": 1
        },
        {
          "label": "2",
          "key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_BEDSIDE_DRAWER_2",
          "id": 64,
          "raw": "[@][ItemReceiver] got an Asthma Spray.",
          "first_segment": 126,
          "segment_count": 1
        },
        {
          "label": "3",
          "key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_BEDSIDE_DRAWER_3",
          "id": 65,
          "raw": "[@]Found an Asthma Spray, but your inventory's full...",
          "first_segment": 127,
          "segment_count": 1
        },
        {
          "label": "4",
          "key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_BEDSIDE_DRAWER_4",
          "id": 66,
          "raw": "[@]There's nothing much to see here...",
          "first_segment": 128,
          "segment_count": 1
        }
      ],
      "drawer": true
    },
