  "texts": [
    {
      "id": 81,
      "label": "0",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_0",
      "raw": "[@][PartyLead] opened the present.",
      "localized": {
        "en": "[@][PartyLead] opened the present.",
        "zh_Hans_CN": "[@][PartyLead]拆开了礼物盒。"
      },
      "speaker": "",
      "voice": ""
    },
    {
      "id": 82,
      "label": "1",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_1",
      "raw": "[@][Ninten] got his [color]Great Grand-Father's Diary[/color]!",
      "localized": {
        "en": "[@][Ninten] got his [color]Great Grand-Father's Diary[/color]!",
        "zh_Hans_CN": "[@][Ninten]获得了[color]曾祖父的日记[/color]！"
      },
      "speaker": "",
      "voice": ""
    },
    {
      "id": 83,
      "label": "4",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_4",
      "raw": "[@][Ninten]... Please... come find me...",
      "localized": {
        "en": "[@][Ninten]... Please... come find me...",
        "zh_Hans_CN": "[@][Ninten]…请你…找到我…"
      },
      "speaker": "???",
      "voice": "Audio/Sound effects/text/Female.mp3"
    },
    {
      "id": 84,
      "label": "5",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_5",
      "raw": "[@]Seek the [color]shell in the cave[/color]...",
      "localized": {
        "en": "[@]Seek the [color]shell in the cave[/color]...",
        "zh_Hans_CN": "[@]如果你要寻求真相…[WAIT@]就听从指引，找到[color]山洞里的海螺[/color]…"
      },
      "speaker": "???",
      "voice": "Audio/Sound effects/text/Female.mp3"
    },
    {
      "id": 85,
      "label": "6",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_6",
      "raw": "[@]Do so, and the wisdom of the world shall be unveiled...",
      "localized": {
        "en": "[@]Do so, and the wisdom of the world shall be unveiled...",
        "zh_Hans_CN": "[@]这样做的话，世间智慧便会展露无遗…"
      },
      "speaker": "???",
      "voice": "Audio/Sound effects/text/Female.mp3"
    },
    {
      "id": 86,
      "label": "8",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_8",
      "raw": "[@]Something awoke inside [Ninten]!",
      "localized": {
        "en": "[@]Something awoke inside [Ninten]!",
        "zh_Hans_CN": "[@]某种力量在[Ninten]体内苏醒了！"
      },
      "speaker": "",
      "voice": ""
    },
    {
      "id": 87,
      "label": "9",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_9",
      "raw": "[@][Ninten] learned Lifeup!",
      "localized": {
        "en": "[@][Ninten] learned Lifeup!",
        "zh_Hans_CN": "[@][Ninten]学会了生命回复！"
      },
      "speaker": "",
      "voice": ""
    },
    {
      "id": 88,
      "label": "10",
      "source_path": "Data/Dialogue/Podunk/cutscenes/ggf_diary.yaml",
      "translation_key": "DIALOGUE_PODUNK_CUTSCENES_GGF_DIARY_10",
      "raw": "[@]Press [color]START[/color] and open your [color]PSI[/color] menu to use [color]Lifeup.[/color]",
      "localized": {
        "en": "[@]Press [color]START[/color] and open your [color]PSI[/color] menu to use [color]Lifeup.[/color]",
        "zh_Hans_CN": "[@]按下[color]START[/color]打开你的[color]PSI[/color]菜单，即可使用[color]生命回复[/color]。"
      },
      "speaker": "",
      "voice": ""
    }
  ],
