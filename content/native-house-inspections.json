  "texts": [
    {
      "source_path": "Data/Dialogue/Podunk/non-person text/Ninten's house/Pinboard.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_PINBOARD_0",
      "raw": "[@]A mess of notes and newspaper clippings about the George and Maria case.[WAIT@]One note sticks out in particular.[WAIT@](A curiosity the police uncovered was Maria's missing necklace.[WAIT@]It was a family pendant passed down from generation to generation.[WAIT@]She always kept it safe, but when she went missing, the necklace was nowhere to be found.)"
    },
    {
      "source_path": "Data/Dialogue/Reusable/nottime.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_REUSABLE_NOTTIME_0",
      "raw": "[@]Now's not the time for that!"
    },
    {
      "source_path": "Data/Dialogue/Podunk/non-person text/Ninten's house/Old Photos.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_OLD_PHOTOS_0",
      "raw": "[@]Two photographs stand on the drawer.[WAIT@]The first one has your family standing in front of the house.[WAIT@]Everyone's overjoyed beyond words.[WAIT@]The second is an old sepia photo.[WAIT@]A couple standing beside each other with similar glee."
    },
    {
      "source_path": "Data/Dialogue/Podunk/non-person text/Ninten's house/Electric Guitar.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_ELECTRIC_GUITAR_0",
      "raw": "[@]Your electric guitar.[WAIT@]Your old man got you this for Christmas.[WAIT@]Mick sometimes sneaks up to hear you rock out."
    },
    {
      "source_path": "Data/Dialogue/Podunk/non-person text/Ninten's house/NES.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_NES_0",
      "raw": "[@]A [Ninten]do Entertainment System.[WAIT@]Inside is a cartridge with a dozen games packed in.[WAIT@]Whoever made this must be really generous."
    },
    {
      "source_path": "Data/Dialogue/Podunk/non-person text/Ninten's house/TV.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_TV_0",
      "raw": "[@]TV with a built-in VHS player.[WAIT@]Star Wars, Rambo and a bunch of other movie tapes are scrambled on the floor."
    },
    {
      "source_path": "Data/Dialogue/Podunk/non-person text/Ninten's house/Downstairs TV.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_DOWNSTAIRS_TV_0",
      "raw": "[@]There's a man on the news being interviewed about a recent surge in paranormal activity.[WAIT@]He sure is waving his arms around a lot."
    },
    {
      "source_path": "Data/Dialogue/Podunk/non-person text/Ninten's house/Mimmie Toybox.yaml",
      "label": "0",
      "translation_key": "DIALOGUE_PODUNK_NON-PERSON_TEXT_NINTEN_S_HOUSE_MIMMIE_TOYBOX_0",
      "raw": "[@]A treasure trove of old toys."
    }
  ],
