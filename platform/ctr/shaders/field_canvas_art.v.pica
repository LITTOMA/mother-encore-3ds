.fvec projection[4]
.constf values(0.0,1.0,0.00392156862745098,0.5)
.out position position
.out color color
.out texcoord texcoord0
.entry vmain
.proc vmain
 mov r0.xyz,v0
 mov r0.w,values.y
 dp4 position.x,projection[0],r0
 dp4 position.y,projection[1],r0
 dp4 position.z,projection[2],r0
 dp4 position.w,projection[3],r0
 mul color,values.z,v2
 mov texcoord,v1
 end
.end
