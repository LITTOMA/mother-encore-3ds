; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Area2D",
"class": "Camarea",
"language": "GDScript",
"path": "res://Scripts/Main/camarea.gd"
}, {
"base": "Camarea",
"class": "CamareaDunroom",
"language": "GDScript",
"path": "res://Scripts/Main/camarea_dunroom.gd"
}, {
"base": "Node2D",
"class": "DungeonAreaRoom",
"language": "GDScript",
"path": "res://dungeon.gd"
} ]
_global_script_class_icons={
"Camarea": "",
"CamareaDunroom": "",
"DungeonAreaRoom": ""
}

[application]

config/name="Source dungeon camera rooms"
run/main_scene="res://probe.tscn"

[autoload]

global="*res://global.gd"
globaldata="*res://data.gd"

[debug]

gdscript/warnings/unused_argument=false
