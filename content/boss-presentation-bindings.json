  "source_facts": {
    "Scripts/UI/Battle/BattleSystem.gd": [
      "$BossDefeatFlash.connect(\"animation_finished\", self, \"_win\")",
      "$BossDefeatFlash.connect(\"defeat_enemies\", self, \"_kill_all_enemies\")",
      "bp.get_plate().stop_scrolling()",
      "pause_battle()"
    ],
    "Scripts/UI/Battle/BattleParticipant.gd": [
      "if is_boss() and !silent:",
      "yield(_battle_sprite, \"start_boss_defeat_flash\")"
    ],
    "Scripts/UI/Battle/EnemySprite.gd": [
      "if boss: $AnimationPlayer.play(\"bossDefeat\")",
      ".set_shake_diminish(false).start()"
    ],
    "Scripts/UI/Battle/BossDefeatFlash.gd": [
      "animation_player.play(\"DefeatFlash\")",
      "emit_signal(\"animation_finished\")"
    ],
    "Scripts/global/PartyMember.gd": [
      "return _set_exp(_exp + quantity, true, out_stats, out_learned_skills)",
      "_exp = min(new_value, _level_to_exp(LEVEL_CAP)) as int",
      "var new_level := _exp_to_level(_exp)",
      "if _level != new_level:",
      "var difference := new_value - get_base_stat(stat)",
      "set_stat(stat, new_value)",
      "if difference > 0:",
      "_learn_new_skills(level_diff, out_learned_skills)",
      "return int(lerp(lower_stat, upper_stat, level_units / 10.0))"
    ],
    "Scripts/global/Character.gd": [
      "set_hp(_hp + diff)",
      "set_pp(_pp + diff)"
    ]
  }
