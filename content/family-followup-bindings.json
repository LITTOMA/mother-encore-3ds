  "texts": [
    {
      "id": 48,
      "source_path": "Data/Dialogue/Podunk/carol_key.yaml",
      "label": "0",
      "speaker": "Carol",
      "voice": "Audio/Sound effects/text/Female.mp3",
      "segments": [
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "So you're leaving, huh?"
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "I guess all boys have to leave home someday..."
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "If you want to know where I put the "
            },
            {
              "kind": "HintStart"
            },
            {
              "kind": "Literal",
              "text": "Basement Key"
            },
            {
              "kind": "HintEnd"
            },
            {
              "kind": "Literal",
              "text": ", I gave it to "
            },
            {
              "kind": "HintStart"
            },
            {
              "kind": "Literal",
              "text": "Mick."
            },
            {
              "kind": "HintEnd"
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "Don't tell Mimmie, though."
            }
          ],
          "wait_for_input": false
        }
      ]
    },
    {
      "id": 49,
      "source_path": "Data/Dialogue/Podunk/carol_key.yaml",
      "label": "4",
      "speaker": "Carol",
      "voice": "Audio/Sound effects/text/Female.mp3",
      "segments": [
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "I made sure to keep all the Orange Juice away from her."
            }
          ],
          "wait_for_input": false
        }
      ]
    },
    {
      "id": 50,
      "source_path": "Data/Dialogue/Podunk/carol_key_again.yaml",
      "label": "0",
      "speaker": "Carol",
      "voice": "Audio/Sound effects/text/Female.mp3",
      "segments": [
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "I gave the "
            },
            {
              "kind": "HintStart"
            },
            {
              "kind": "Literal",
              "text": "Basement Key"
            },
            {
              "kind": "HintEnd"
            },
            {
              "kind": "Literal",
              "text": " to "
            },
            {
              "kind": "HintStart"
            },
            {
              "kind": "Literal",
              "text": "Mick."
            },
            {
              "kind": "HintEnd"
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "Don't tell Mimmie, though."
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "I made sure to keep all the Orange Juice away from her."
            }
          ],
          "wait_for_input": false
        }
      ]
    },
    {
      "id": 51,
      "source_path": "Data/Dialogue/Podunk/mimmie_key.yaml",
      "label": "0",
      "speaker": "Mimmie",
      "voice": "Audio/Sound effects/text/Kid.mp3",
      "segments": [
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "The Basement Key?"
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "Ah, I see..."
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "So you're also after the secret treasure in the basement, aren't you?"
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "I'm talking about the lifetime supply of Orange Juice."
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "Unfortunately, the basement is locked right now."
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "I tried asking mom where the key is, but she won't tell me."
            }
          ],
          "wait_for_input": true
        },
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "Maybe she'll listen to you, though. Try asking her."
            }
          ],
          "wait_for_input": false
        }
      ]
    },
    {
      "id": 52,
      "source_path": "Data/Dialogue/Podunk/mimmie_key.yaml",
      "label": "7",
      "speaker": "Mimmie",
      "voice": "Audio/Sound effects/text/Kid.mp3",
      "segments": [
        {
          "bullet": true,
          "tokens": [
            {
              "kind": "Literal",
              "text": "If you manage to unlock the basement, I'll find all of the Orange Juice for you."
            }
          ],
          "wait_for_input": false
        }
      ]
    },
