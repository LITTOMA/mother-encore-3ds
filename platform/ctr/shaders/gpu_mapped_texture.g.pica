.gsh point c0
.constf values(0.0, 1.0, 0.5, -0.5)
.constf scale(0.00390625, 0.0078125, 0.875, 0.5625)
.out position position
.out tex0 texcoord0
.out tex1 texcoord1
.entry gmain
.proc gmain
 ; Integer pixel coordinates times 1/128 or 1/256 are exact binary values.
 ; Transform the left/top and width once; all four original corners retain
 ; exactly the same position, UV endpoints, order and winding.
 mov r2, v0
 mul r0.x, scale.y, r2.y
 add r0.x, scale.z, -r0.x
 mul r0.y, scale.x, r2.x
 add r0.y, scale.w, -r0.y
 mul r0.z, scale.x, r2.z
 mov position.z, values.w
 mov position.w, values.y
 mov tex0.z, values.x
 mov tex1.z, values.x

 setemit 0
 mov position.xy, r0.xy
 mov tex0.xy, v1.xy
 mov tex1.xy, v1.zw
 emit

 ; Keep the same v1 + v2 operation for the right UV endpoint.
 mov r1, v1
 add r1, r1, v2
 setemit 1
 add position.y, r0.y, -r0.z
 mov tex0.xy, r1.xy
 mov tex1.xy, r1.zw
 emit

 setemit 2, prim
 add position.x, r0.x, -scale.y
 mov position.y, r0.y
 mov tex0.xy, v1.xy
 mov tex1.xy, v1.zw
 emit

 setemit 0, inv prim
 add position.y, r0.y, -r0.z
 mov tex0.xy, r1.xy
 mov tex1.xy, r1.zw
 emit
 end
.end
