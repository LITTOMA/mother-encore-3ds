; One input span expands to four corners/two triangles on the PICA.
; Pixel boundaries are integer x,y,width; no texture or UV approximation.
.gsh point c0
.fvec projection[4]
.constf values(0.0, 1.0, -1.0, 0.5)
.out position position
.out color color
.entry gmain
.proc gmain
 mov r0.xy, v0
 mov r0.z, values.x
 mov r0.w, values.y
 setemit 0
 call corner
 emit
 add r0.x, r0.x, v0.z
 setemit 1
 call corner
 emit
 mov r0.x, v0.x
 add r0.y, values.y, r0.y
 setemit 2, prim
 call corner
 emit
 add r0.x, r0.x, v0.z
 setemit 0, inv prim
 call corner
 emit
 end
.end
.proc corner
 dp4 position.x, projection[0], r0
 dp4 position.y, projection[1], r0
 dp4 position.z, projection[2], r0
 dp4 position.w, projection[3], r0
 mov color, v1
.end
