  "steps": [
    {
      "step": 0,
      "source": "remove_child(global.get_player())"
    },
    {
      "step": 1,
      "source": "set_collisions(false)"
    },
    {
      "step": 2,
      "source": "for node in global.get_persistent():"
    },
    {
      "step": 3,
      "source": "var new_scene = ResourceLoader.load(path).instance()"
    },
    {
      "step": 4,
      "source": "global.currentScene.leave_for(new_scene)"
    },
    {
      "step": 5,
      "source": "global.currentScene.free()"
    },
    {
      "step": 6,
      "source": "global.currentScene = new_scene"
    },
    {
      "step": 7,
      "source": "global.currentScene.callv(\"init_params\", params)"
    },
    {
      "step": 8,
      "source": "get_tree().get_root().add_child(global.currentScene)"
    },
    {
      "step": 9,
      "source": "global.get_current_scene_player_node().add_child(global.get_player())"
    },
    {
      "step": 10,
      "source": "global.create_party_followers()"
    },
    {
      "step": 11,
      "source": "global.set_party_position(player_pos, player_dir)"
    },
    {
      "step": 12,
      "source": "global.get_current_scene_player_node().add_child(node)"
    },
    {
      "step": 13,
      "source": "get_tree().set_current_scene(global.currentScene)"
    },
    {
      "step": 14,
      "source": "uiManager.update_key_indicator()"
    },
    {
      "step": 15,
      "source": "global.get_player().set_collisions(true)"
    }
  ],
