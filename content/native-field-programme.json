  "texts": [
    {
      "id": 70,
      "source": "Data/Dialogue/Podunk/woof.yaml",
      "label": "0",
      "key": "DIALOGUE_PODUNK_WOOF_0",
      "speaker_key": "DIALOGUE_PODUNK_WOOF_SPEAKER_Mick",
      "speakers": {
        "en": "Mick",
        "zh_Hans_CN": "米克"
      },
      "voice": "",
      "segments": {
        "en": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "Woof woof!"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(Grrr, my butt is so itchy!)"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(Stop standing there and lend me a hand!)"
              }
            ]
          }
        ],
        "zh_Hans_CN": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "汪汪！"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "（呃——，我的屁股好痒啊！）"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "（别光站在那儿，快帮我一把！）"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 71,
      "source": "Data/Dialogue/Podunk/woof.yaml",
      "label": "3",
      "key": "DIALOGUE_PODUNK_WOOF_3",
      "speaker_key": "",
      "speakers": {
        "en": "",
        "zh_Hans_CN": ""
      },
      "voice": "",
      "segments": {
        "en": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "PlayerName"
              },
              {
                "kind": "Literal",
                "text": " gave Mick a good scratch!"
              }
            ]
          }
        ],
        "zh_Hans_CN": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "PlayerName"
              },
              {
                "kind": "Literal",
                "text": "给米克好好挠了挠痒！"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 72,
      "source": "Data/Dialogue/Podunk/woof.yaml",
      "label": "4",
      "key": "DIALOGUE_PODUNK_WOOF_4",
      "speaker_key": "DIALOGUE_PODUNK_WOOF_SPEAKER_Mick",
      "speakers": {
        "en": "Mick",
        "zh_Hans_CN": "米克"
      },
      "voice": "",
      "segments": {
        "en": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(Ahhh, many thanks.)"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(Wait a minute, you can understand me?)"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(You must have learned "
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "Literal",
                "text": "Telepathy"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
                "text": "!)"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(That's great and all, but don't you dare use it on me by pressing "
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "InputAction",
                "action": "ui_select"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
                "text": " and selecting it within the "
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "Literal",
                "text": "PSI menu"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
                "text": ".)"
              }
            ]
          }
        ],
        "zh_Hans_CN": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "（啊啊啊，感激不尽。）"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "（等一下，你能听懂我说话？）"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "（你一定是学会了"
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "Literal",
                "text": "心灵感应"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
                "text": "吧！）"
              }
            ]
          },
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "（那倒是挺厉害的，不过你可别通过按"
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "InputAction",
                "action": "ui_select"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
                "text": "并在"
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "Literal",
                "text": "PSI菜单"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
                "text": "里选择它来对我使用哦。）"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 73,
      "source": "Data/Dialogue/Podunk/woof.yaml",
      "label": "8",
      "key": "DIALOGUE_PODUNK_WOOF_8",
      "speaker_key": "DIALOGUE_PODUNK_WOOF_SPEAKER_Mick",
      "speakers": {
        "en": "Mick",
        "zh_Hans_CN": "米克"
      },
      "voice": "",
      "segments": {
        "en": [
          {
            "bullet": true,
            "tokens": [
              {
                "kind": "Literal",
                "text": "(And don't even think of using it by simply holding down "
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "InputAction",
                "action": "ui_toggle"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
                "text": " and pressing "
              },
              {
                "kind": "HintStart"
              },
              {
                "kind": "InputAction",
                "action": "ui_accept"
              },
              {
                "kind": "HintEnd"
              },
              {
                "kind": "Literal",
